---
import '../styles/global.css';
import { SITE, CONTACT } from '../consts';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = `${SITE.name} | ${SITE.tagline}`,
  description = SITE.description,
  canonical,
  ogImage = '/images/Zambia_IPv6_association_badge_5fe0b2a8__1_-removebg-preview-300x167.png',
} = Astro.props;

// Ensure strict production canonical URLs built from astro.config.mjs `site`
const siteOrigin = Astro.site?.href ?? SITE.url;
const canonicalURL = canonical || new URL(Astro.url.pathname, siteOrigin).href;
const ogImageURL = new URL(ogImage, siteOrigin).href;

// Schema.org structured data for Non-Governmental / Non-Profit Association
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITE.name,
  alternateName: 'Internet Protocol version 6 Council of Zambia',
  url: siteOrigin,
  logo: new URL('/images/WhatsApp_Image_2026-11-15_at_5.06.47_PM-removebg-preview.png', siteOrigin).href,
  image: ogImageURL,
  description: SITE.description,
  telephone: CONTACT.phone,
  email: CONTACT.email,
  areaServed: {
    '@type': 'Country',
    name: 'Zambia',
  },
  knowsAbout: [
    'IPv6',
    'IPv6 Migration',
    'Network Engineering',
    'Internet Governance',
    'Telecommunications',
    'Cybersecurity',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Standard SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#040404" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Google Fonts: Funnel Display (700) & Lato (400, 600, 700) matching reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@600;700;800&family=Lato:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body>
    <slot />
  </body>
</html>
