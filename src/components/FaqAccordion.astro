---
import { FAQ_ITEMS } from '../consts';
---

<div id="faq" class="c-faq">
  <div class="c-faq__header">
    <div class="u-badge u-badge--primary">Common Questions</div>
    <h2 class="c-faq__title">Commonly asked questions and answers</h2>
    <p class="c-faq__subtitle">Clear, direct answers regarding the council, our mandate, and the transition path.</p>
  </div>

  <div class="c-faq__list l-stack">
    {
      FAQ_ITEMS.map((item, index) => (
        <details class="c-faq__item l-card" open={index === 0}>
          <summary class="c-faq__question">
            <span>{item.question}</span>
            <span class="c-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="c-faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .c-faq {
    width: 100%;
  }

  .c-faq__header {
    margin-block-end: var(--space-md);
  }

  .c-faq__title {
    font-size: var(--font-size-h2);
    margin-block: var(--space-2xs);
  }

  .c-faq__subtitle {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
  }

  .c-faq__item {
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .c-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    font-weight: 700;
    font-size: var(--font-size-body);
    color: var(--color-brand-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .c-faq__question::-webkit-details-marker {
    display: none;
  }

  .c-faq__icon {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-brand-accent);
    transition: transform var(--transition-fast);
  }

  details[open] .c-faq__icon {
    transform: rotate(45deg);
  }

  .c-faq__answer {
    padding: 0 var(--space-lg) var(--space-lg);
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }
</style>
