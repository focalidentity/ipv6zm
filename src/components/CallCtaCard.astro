---
import { CONTACT } from '../consts';
---

<div class="c-call-card">
  <h2 class="c-call-card__title">Have more questions?</h2>
  <p class="c-call-card__text">
    Book a short call with the Council to talk about membership, sponsorship or IPv6 training for your organisation.
  </p>
  <div class="c-call-card__action">
    <a href={CONTACT.phoneTel} class="c-call-card__link">
      <span>Book a call now</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2.9 7H11.1M11.1 7L7 2.9M11.1 7L7 11.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>

<style>
  /* Reference Solid Orange Card (#FD5320) with 30px radius */
  .c-call-card {
    background-color: var(--color-brand-accent);
    border-radius: 30px;
    padding: clamp(2rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    color: #ffffff;
  }

  .c-call-card__title {
    font-family: var(--font-heading);
    font-size: 1.5625rem; /* 25px */
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .c-call-card__text {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .c-call-card__action {
    margin-top: auto;
  }

  .c-call-card__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity var(--transition-fast);
  }

  .c-call-card__link:hover {
    opacity: 0.9;
  }
</style>
