---
---

<section class="c-event l-section l-section--dark">
  <div class="l-container">
    <div class="u-section-header u-text-center">
      <div class="u-badge u-badge--gold">National Conference Logistics</div>
      <h2>One platform to register, book and attend</h2>
      <p class="u-text-inverse-muted">
        Everything for the conference and workshops in one place: tickets, workshop seats, hotels, transport and parking.
      </p>
    </div>

    <div class="l-grid l-grid--2col">
      <div class="c-event__card l-card">
        <h3 class="c-event__card-title">Workshop and conference registration</h3>
        <p class="c-event__card-desc">
          Choose your ticket, pay safely and get your confirmation and schedule by email.
        </p>
        <div class="c-event__card-action">
          <a href="/contact" class="u-btn u-btn--primary">Get in touch</a>
        </div>
      </div>

      <div class="c-event__card l-card">
        <h3 class="c-event__card-title">Hotels, transport and logistics</h3>
        <p class="c-event__card-desc">
          Book partner accommodation, arrange local transfers, and secure venue parking ahead of the June 2027 summit.
        </p>
        <div class="c-event__card-action">
          <a href="/contact" class="u-btn u-btn--primary">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .c-event__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-xl);
    gap: var(--space-md);
  }

  .c-event__card-title {
    font-size: var(--font-size-h3);
  }

  .c-event__card-desc {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
  }
</style>
