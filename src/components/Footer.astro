---
import { SITE, NAV_LINKS, CONTACT } from '../consts';
---

<footer class="c-footer">
  <div class="l-container">
    <div class="c-footer__content">
      <!-- Middle Row: Clean, undistorted Brand Emblem (True shape and colours on mobile/tablet) -->
      <div class="c-footer__middle">
        <img
          src="/images/WhatsApp_Image_2026-11-15_at_5.06.47_PM-removebg-preview.png"
          alt="IPv6 Council of Zambia Logo"
          width="254"
          height="179"
          class="c-footer__logo"
          loading="lazy"
        />
        <p class="c-footer__tagline">
          Uniting network engineers, policymakers, government, commercial banks, and telecommunications operators to secure Zambia's digital sovereignty.
        </p>
      </div>

      <!-- Desk / Contact: phone and email -->
      <div class="c-footer__desk">
        <span>Secretariat: <a href={CONTACT.phoneTel}>{CONTACT.phoneDisplay}</a></span>
        <span class="c-footer__desk-dot">·</span>
        <span><a href={CONTACT.emailMailto}>{CONTACT.email}</a></span>
      </div>

      <!-- Navigation Links: wrap and centre -->
      <div class="c-footer__nav-wrap">
        <ul class="c-footer__nav-list">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="c-footer__nav-link">
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Bottom Row: Copyright + Participation & Legal Links -->
      <div class="c-footer__bottom">
        <p class="c-footer__copy">
          Copyright © 2026 - {SITE.name}. All rights reserved.
        </p>

        <div class="c-footer__links">
          <a href="/privacy" class="c-footer__sublink">Privacy Policy</a>
          <span class="c-footer__pipe">|</span>
          <a href="/terms" class="c-footer__sublink">Terms of Use</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Reference Footer: #040404 + wavy background texture */
  .c-footer {
    background-color: #040404;
    background-image: linear-gradient(rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.4)), url('/images/hero-section-background-scaled-1.webp');
    background-size: cover;
    background-position: center top;
    color: #ffffff;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: auto;
  }

  /* Mobile and Tablet: Everything centred and stacked, no left/right split, logo true colours */
  @media (max-width: 63.99rem) {
    .c-footer__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2rem;
    }

    .c-footer__middle {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }

    .c-footer__logo {
      height: 65px;
      width: auto;
      object-fit: contain;
      /* True colours: no brightness(0) invert(1) on mobile/tablet */
      filter: none;
    }

    .c-footer__tagline {
      font-family: var(--font-sans);
      font-size: 0.9375rem;
      color: var(--color-text-inverse-muted);
      max-width: 34rem;
      margin: 0;
      line-height: 1.6;
    }

    .c-footer__desk {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--font-sans);
      font-size: 0.9375rem;
      color: var(--color-text-inverse-muted);
    }

    .c-footer__nav-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      padding-block: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .c-footer__nav-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin: 0;
      padding: 0;
    }

    .c-footer__bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      font-size: 14px;
      color: var(--color-text-inverse-muted);
    }

    .c-footer__links {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
    }
  }

  /* Desktop (>= 64rem) - MUST NOT CHANGE */
  @media (min-width: 64rem) {
    .c-footer__content {
      display: flex;
      flex-direction: column;
    }

    .c-footer__middle {
      order: 2;
      padding-block: 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }

    .c-footer__logo {
      height: 70px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
      opacity: 0.95;
    }

    .c-footer__tagline {
      font-family: var(--font-sans);
      font-size: 0.9375rem;
      color: var(--color-text-inverse-muted);
      max-width: 38rem;
      margin: 0;
      line-height: 1.6;
    }

    .c-footer__desk {
      order: 1;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--color-text-inverse-muted);
      margin-top: -3.5rem;
      margin-bottom: 1.5rem;
    }

    .c-footer__nav-wrap {
      order: 1;
      display: flex;
      justify-content: flex-start;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .c-footer__nav-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      margin: 0;
      padding: 0;
    }

    .c-footer__bottom {
      order: 3;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 14px;
      color: var(--color-text-inverse-muted);
    }

    .c-footer__links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }
  }

  .c-footer__nav-link {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    transition: color var(--transition-fast);
  }

  .c-footer__nav-link:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__desk a {
    color: #ffffff;
    font-weight: 600;
  }

  .c-footer__desk a:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__desk-dot {
    color: rgba(255, 255, 255, 0.3);
  }

  .c-footer__copy {
    margin: 0;
  }

  .c-footer__sublink {
    color: var(--color-text-inverse-muted);
    font-size: 14px;
    transition: color var(--transition-fast);
  }

  .c-footer__sublink:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__pipe {
    color: rgba(255, 255, 255, 0.2);
  }
</style>
