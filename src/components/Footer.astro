---
import { SITE, NAV_LINKS, CONTACT } from '../consts';
---

<footer class="c-footer">
  <div class="l-container">
    <!-- Top Row: Navigation Links & Secretariat Direct Contact -->
    <div class="c-footer__top">
      <ul class="c-footer__nav-list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="c-footer__nav-link">
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="c-footer__desk">
        <span>Secretariat: <a href={CONTACT.phoneTel}>{CONTACT.phoneDisplay}</a></span>
        <span class="c-footer__desk-dot">·</span>
        <span><a href={CONTACT.emailMailto}>{CONTACT.email}</a></span>
      </div>
    </div>

    <!-- Middle Row: Clean, undistorted Brand Emblem -->
    <div class="c-footer__middle">
      <img
        src="/images/WhatsApp_Image_2026-11-15_at_5.06.47_PM-removebg-preview.png"
        alt="IPv6 Council of Zambia Logo"
        width="254"
        height="179"
        class="c-footer__logo"
        loading="lazy"
      />
      <p class="c-footer__tagline">
        Uniting network engineers, policymakers, government, commercial banks, and telecommunications operators to secure Zambia's digital sovereignty.
      </p>
    </div>

    <!-- Bottom Row: Copyright + Participation & Legal Links -->
    <div class="c-footer__bottom">
      <p class="c-footer__copy">
        Copyright © 2026 - {SITE.name}. All rights reserved.
      </p>

      <div class="c-footer__links">
        <a href="/register?event=capacity-workshops" class="c-footer__sublink">Workshop Registration</a>
        <span class="c-footer__pipe">|</span>
        <a href="/register?event=national-conference-2027" class="c-footer__sublink">Conference 2027</a>
        <span class="c-footer__pipe">|</span>
        <a href="/subscribe" class="c-footer__sublink">Subscribe</a>
        <span class="c-footer__pipe">|</span>
        <a href="/privacy" class="c-footer__sublink">Privacy Policy</a>
        <span class="c-footer__pipe">|</span>
        <a href="/terms" class="c-footer__sublink">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Reference Footer: #040404 + wavy background texture */
  .c-footer {
    background-color: #040404;
    background-image: linear-gradient(rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.4)), url('/images/hero-section-background-scaled-1.webp');
    background-size: cover;
    background-position: center top;
    color: #ffffff;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: auto;
  }

  /* Row 1: Top Navigation matching Reference (12px bold uppercase white) */
  .c-footer__top {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 48rem) {
    .c-footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .c-footer__nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin: 0;
    padding: 0;
  }

  .c-footer__nav-link {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    transition: color var(--transition-fast);
  }

  .c-footer__nav-link:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__desk {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-inverse-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .c-footer__desk a {
    color: #ffffff;
    font-weight: 600;
  }

  .c-footer__desk a:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__desk-dot {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Row 2: Middle Brand Center */
  .c-footer__middle {
    padding-block: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .c-footer__logo {
    height: 70px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .c-footer__tagline {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text-inverse-muted);
    max-width: 38rem;
    margin: 0;
    line-height: 1.6;
  }

  /* Row 3: Bottom Copyright & Sublinks */
  .c-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 48rem) {
    .c-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .c-footer__copy {
    margin: 0;
  }

  .c-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .c-footer__sublink {
    color: var(--color-text-inverse-muted);
    font-size: 14px;
    transition: color var(--transition-fast);
  }

  .c-footer__sublink:hover {
    color: var(--color-brand-accent);
  }

  .c-footer__pipe {
    color: rgba(255, 255, 255, 0.2);
  }
</style>
