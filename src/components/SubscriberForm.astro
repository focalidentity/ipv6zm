---
interface Props {
  title?: string;
  subtitle?: string;
  compact?: boolean;
}

const {
  title = "Subscribe to IPv6 Zambia Updates & Technical Dispatches",
  subtitle = "Receive policy papers, technical migration guides, and priority announcements for workshops and the National Conference.",
  compact = false,
} = Astro.props;
---

<div class:list={['c-subscriber-card', 'l-card', 'l-card--accent', { 'c-subscriber-card--compact': compact }]}>
  <div class="u-badge u-badge--accent">Official Bulletins</div>
  <h3 class="c-subscriber-card__title">{title}</h3>
  <p class="c-subscriber-card__subtitle">{subtitle}</p>

  <form id="subscriber-form" class="c-subscriber-form l-stack" novalidate>
    <!-- Status Feedback Region -->
    <div
      id="subscriber-status"
      class="c-subscriber-status"
      role="status"
      aria-live="polite"
      hidden
    ></div>

    <div class="c-subscriber-form__fields">
      <div class="c-form__field">
        <label for="sub-email">Email Address <span class="u-text-accent">*</span></label>
        <input
          type="email"
          id="sub-email"
          name="email"
          required
          placeholder="engineer@company.zm"
          autocomplete="email"
          class="c-subscriber-input"
        />
      </div>

      {!compact && (
        <div class="c-form__field">
          <label for="sub-name">Full Name (Optional)</label>
          <input
            type="text"
            id="sub-name"
            name="name"
            placeholder="e.g. Kondwani Phiri"
            autocomplete="name"
            class="c-subscriber-input"
          />
        </div>
      )}
    </div>

    {!compact && (
      <div class="c-subscriber-form__preferences">
        <span class="c-subscriber-label">Update Preferences:</span>
        <div class="c-subscriber-checks">
          <label class="c-subscriber-check">
            <input type="checkbox" name="interest-conference" checked />
            <span>National Conference 2027 Updates</span>
          </label>
          <label class="c-subscriber-check">
            <input type="checkbox" name="interest-workshops" checked />
            <span>Capacity-Building Workshops</span>
          </label>
          <label class="c-subscriber-check">
            <input type="checkbox" name="interest-policy" checked />
            <span>Policy & Regulatory Briefings</span>
          </label>
          <label class="c-subscriber-check">
            <input type="checkbox" name="interest-research" checked />
            <span>National Research & Readiness Reports</span>
          </label>
        </div>
      </div>
    )}

    <div class="c-subscriber-form__actions">
      <button type="submit" id="sub-submit-btn" class="u-btn u-btn--accent">
        Subscribe to Dispatches
      </button>
      <span class="c-subscriber-privacy">
        No spam. Unsubscribe anytime. Official Secretariat communications only.
      </span>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('subscriber-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('subscriber-status');
  const submitBtn = document.getElementById('sub-submit-btn') as HTMLButtonElement | null;

  if (form && statusEl && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector('#sub-email') as HTMLInputElement | null;

      if (!emailInput || !emailInput.value.trim() || !emailInput.checkValidity()) {
        statusEl.removeAttribute('hidden');
        statusEl.className = 'c-subscriber-status c-subscriber-status--error';
        statusEl.textContent = 'Please enter a valid official email address.';
        emailInput?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Subscribing...';
      statusEl.setAttribute('hidden', '');

      const formData = new FormData(form);
      const payload = {
        email: formData.get('email'),
        name: formData.get('name') || '',
        interests: {
          conference: formData.get('interest-conference') === 'on',
          workshops: formData.get('interest-workshops') === 'on',
          policy: formData.get('interest-policy') === 'on',
          research: formData.get('interest-research') === 'on',
        },
        source: window.location.pathname,
        submittedAt: new Date().toISOString(),
      };

      // Check if a remote endpoint is configured via environment
      // @ts-ignore
      const endpoint = import.meta.env?.PUBLIC_NEWSLETTER_ENDPOINT;

      if (endpoint && endpoint.startsWith('http')) {
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('Subscription endpoint returned error');
        } catch (err) {
          console.warn('Remote subscription endpoint unavailable; falling back to client confirmation UI.');
        }
      }

      // Display accessible confirmation UI
      statusEl.removeAttribute('hidden');
      statusEl.className = 'c-subscriber-status c-subscriber-status--success';
      statusEl.innerHTML = `
        <strong>Thank you for subscribing!</strong>
        <p style="margin: 0.25rem 0 0 0;">
          A welcome confirmation has been prepared for <code>${emailInput.value}</code>. You will receive official IPv6 Council of Zambia dispatches.
        </p>
      `;

      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subscribed ✓';
      setTimeout(() => {
        submitBtn.textContent = 'Subscribe to Dispatches';
      }, 5000);
    });
  }
</script>

<style>
  .c-subscriber-card {
    padding: var(--space-xl);
  }

  .c-subscriber-card--compact {
    padding: var(--space-lg);
  }

  .c-subscriber-card__title {
    font-size: var(--font-size-h2);
    margin-block: var(--space-2xs);
  }

  .c-subscriber-card--compact .c-subscriber-card__title {
    font-size: var(--font-size-h3);
  }

  .c-subscriber-card__subtitle {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    margin-block-end: var(--space-md);
  }

  .c-subscriber-status {
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .c-subscriber-status--error {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #f87171;
  }

  .c-subscriber-status--success {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }

  .c-subscriber-form {
    gap: var(--space-md);
  }

  .c-subscriber-form__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 36rem) {
    .c-subscriber-form__fields {
      grid-template-columns: 1fr 1fr;
    }
  }

  .c-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .c-form__field label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-brand-primary);
  }

  .c-subscriber-input {
    min-height: 2.75rem; /* 44px touch target */
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 1rem; /* 16px min prevents iOS auto-zoom */
    background-color: #ffffff;
    color: var(--color-text-main);
  }

  .c-subscriber-input:focus {
    outline: 2px solid var(--color-brand-primary);
  }

  .c-subscriber-form__preferences {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .c-subscriber-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .c-subscriber-checks {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
  }

  @media (min-width: 40rem) {
    .c-subscriber-checks {
      grid-template-columns: 1fr 1fr;
    }
  }

  .c-subscriber-check {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    min-height: 2.25rem;
  }

  .c-subscriber-check input[type='checkbox'] {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--color-brand-accent);
  }

  .c-subscriber-form__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }

  @media (min-width: 36rem) {
    .c-subscriber-form__actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .c-subscriber-privacy {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
</style>
