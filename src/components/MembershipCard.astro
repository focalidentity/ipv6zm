---
---

<section class="c-member l-section">
  <div class="l-container">
    <div class="c-member__banner">
      <div class="c-member__left">
        <!-- Site Emblem (Cropped IPv6 Favicon 512x512 with true ratio) -->
        <div class="c-member__icon-wrap">
          <img
            src="/images/cropped-IPv6-favicon.png"
            alt="IPv6 Council Emblem"
            width="512"
            height="512"
            class="c-member__icon"
            loading="lazy"
          />
        </div>
        <div class="c-member__text">
          <p class="c-member__desc">
            Partner with a community that values your skills. Get practical training, expert advice and a national network.
          </p>
          <h2 class="c-member__title">
            Join us today and become a valued member
          </h2>
        </div>
      </div>

      <div class="c-member__right">
        <a href="/contact" class="u-btn u-btn--accent">
          <span>Become a member</span>
          <span class="u-btn__circle">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.9 7H11.1M11.1 7L7 2.9M11.1 7L7 11.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .c-member {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    background-color: #ffffff;
  }

  /* Full-width curved dark wavy banner matching reference */
  .c-member__banner {
    background-color: #040404;
    background-image: url('/images/hero-section-background-scaled-1.webp');
    background-size: cover;
    background-position: center bottom;
    border-radius: var(--radius-card);
    padding: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    color: #ffffff;
  }

  /* Mobile and Tablet: Everything centred */
  @media (max-width: 63.99rem) {
    .c-member__banner {
      align-items: center;
      text-align: center;
    }

    .c-member__left {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      width: 100%;
    }

    .c-member__icon-wrap {
      display: flex;
      justify-content: center;
    }

    .c-member__text {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .c-member__desc {
      order: 1; /* Paragraph above heading like reference */
      max-width: 36rem;
    }

    .c-member__title {
      order: 2;
      max-width: 36rem;
    }

    .c-member__right {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }

  /* Desktop (>= 64rem) - MUST NOT CHANGE */
  @media (min-width: 64rem) {
    .c-member__banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 4rem;
    }

    .c-member__left {
      flex: 0 0 65%;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }

    .c-member__text {
      display: flex;
      flex-direction: column;
    }

    .c-member__title {
      order: 1;
      margin-bottom: 0.5rem;
    }

    .c-member__desc {
      order: 2;
      max-width: 36rem;
    }

    .c-member__right {
      flex: 0 0 35%;
      display: flex;
      justify-content: flex-end;
      width: auto;
    }
  }

  .c-member__icon-wrap {
    flex-shrink: 0;
  }

  .c-member__icon {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: contain;
    background: #ffffff;
    padding: 10px;
    border: 3px solid rgba(253, 83, 32, 0.4);
  }

  .c-member__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    color: #ffffff;
    line-height: 1.25;
  }

  .c-member__desc {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-text-inverse-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
