---

<section class="c-member l-section l-section--muted">
  <div class="l-container">
    <div class="c-member__card l-card l-card--gold">
      <div class="c-member__content l-stack l-stack--sm u-text-center">
        <div class="c-member__icon-wrap">
          <img
            src="/images/cropped-IPv6-favicon.png"
            alt="IPv6 Council Emblem"
            width="64"
            height="64"
            class="c-member__icon"
          />
        </div>
        <h3 class="c-member__title">Join us today and become a valued member</h3>
        <p class="c-member__desc">
          Partner with a community that values your skills. Get practical training, expert advice and a national network.
        </p>
        <div class="c-member__cta">
          <a href="/contact" class="u-btn u-btn--gold">Become a member</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .c-member__card {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-xl);
  }

  .c-member__icon {
    width: 3.5rem;
    height: 3.5rem;
    margin-inline: auto;
  }

  .c-member__title {
    font-size: var(--font-size-h2);
    color: var(--color-brand-primary);
  }

  .c-member__desc {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    max-width: 36rem;
    margin-inline: auto;
  }

  .c-member__cta {
    padding-block-start: var(--space-xs);
  }
</style>
