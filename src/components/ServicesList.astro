---
import { SERVICES } from '../consts';
---

<section id="services" class="c-services l-section">
  <div class="l-container">
    <div class="c-services__header">
      <div class="c-services__title-wrap">
        <h2 class="c-services__title">What we do to move Zambia to IPv6</h2>
        <p class="c-services__lead">
          Specialised institutional assistance, engineering enablement, and advisory services.
        </p>
      </div>
      <div class="c-services__header-action">
        <a href="/services" class="u-link-arrow">
          <span>View all services</span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 8-Column Horizontal Service Rows matching Reference -->
    <div class="c-services__table">
      {
        SERVICES.map((srv) => (
          <div class="c-services__row">
            <div class="c-services__icon-col">
              <div class="u-icon-pill">
                {srv.id === 'training' && (
                  <!-- Nodes icon -->
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"/>
                    <circle cx="6" cy="12" r="3"/>
                    <circle cx="18" cy="19" r="3"/>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                  </svg>
                )}
                {srv.id === 'audits' && (
                  <!-- Toggles icon -->
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="6"/>
                    <circle cx="8" cy="12" r="3"/>
                  </svg>
                )}
                {srv.id === 'policy' && (
                  <!-- Screen/Device icon -->
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                )}
                {srv.id === 'architecture' && (
                  <!-- Code brackets icon -->
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                )}
                {srv.id === 'conference' && (
                  <!-- Atom / concentric circle icon -->
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <circle cx="12" cy="12" r="8"/>
                    <line x1="12" y1="2" x2="12" y2="4"/>
                    <line x1="12" y1="20" x2="12" y2="22"/>
                    <line x1="20" y1="12" x2="22" y2="12"/>
                    <line x1="2" y1="12" x2="4" y2="12"/>
                  </svg>
                )}
              </div>
            </div>

            <div class="c-services__name-col">
              <h3 class="c-services__item-title">{srv.title}</h3>
            </div>

            <div class="c-services__desc-col">
              <p class="c-services__item-summary">{srv.summary}</p>
            </div>

            <div class="c-services__arrow-col">
              <a href="/services" class="c-services__circle-link" aria-label={`Details for ${srv.title}`}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3.33 8H12.67M12.67 8L8 3.33M12.67 8L8 12.67" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .c-services {
    background-color: #ffffff;
    padding-block: clamp(3.75rem, 6vw, 7.5rem);
  }

  .c-services__header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  /* Mobile and Tablet: Heading, paragraph and "View all services" centred, stacked */
  @media (max-width: 63.99rem) {
    .c-services__header {
      align-items: center;
      text-align: center;
    }

    .c-services__title-wrap {
      text-align: center;
    }

    .c-services__header-action {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }

  /* Desktop (>= 64rem) - MUST NOT CHANGE */
  @media (min-width: 64rem) {
    .c-services__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      text-align: left;
    }

    .c-services__title-wrap {
      text-align: left;
    }

    .c-services__header-action {
      display: block;
      width: auto;
    }
  }

  .c-services__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    color: var(--color-text-heading);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .c-services__lead {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--color-brand-charcoal);
    margin: 0;
  }

  /* Table / Row Stack */
  .c-services__table {
    display: flex;
    flex-direction: column;
  }

  .c-services__row {
    display: flex;
    transition: background-color var(--transition-fast);
  }

  .c-services__row:last-child {
    border-bottom: none;
  }

  /* Mobile (<48rem): Stacked and centred with thin line between services */
  @media (max-width: 47.99rem) {
    .c-services__row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
      padding-block: 2.25rem;
      border-bottom: 1px solid var(--color-border);
    }

    .c-services__icon-col {
      display: flex;
      justify-content: center;
    }

    .c-services__arrow-col {
      display: flex;
      justify-content: center;
      margin-top: 0.5rem;
    }
  }

  /* Tablet (48rem to 63.99rem): One row per service like reference: icon, title, text, arrow on right */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .c-services__row {
      display: grid;
      grid-template-columns: 70px 220px 1fr 50px;
      align-items: center;
      gap: 1.5rem;
      padding-block: 2rem;
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }

    .c-services__icon-col {
      display: flex;
      justify-content: flex-start;
    }

    .c-services__arrow-col {
      display: flex;
      justify-content: flex-end;
    }
  }

  /* Desktop (>= 64rem) - MUST NOT CHANGE */
  @media (min-width: 64rem) {
    .c-services__row {
      display: grid;
      grid-template-columns: 80px 240px 1fr 60px;
      align-items: center;
      gap: 2rem;
      padding-block: 2.25rem;
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }

    .c-services__icon-col {
      display: block;
    }

    .c-services__arrow-col {
      display: flex;
      justify-content: flex-end;
    }
  }

  .c-services__icon-col {
    flex-shrink: 0;
  }

  .c-services__item-title {
    font-family: var(--font-heading);
    font-size: 1.25rem; /* 20px */
    color: var(--color-text-heading);
    margin: 0;
    line-height: 1.35;
  }

  .c-services__item-summary {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-brand-charcoal);
    line-height: 1.6;
    margin: 0;
  }

  /* Black round arrow button */
  .c-services__circle-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #040404;
    border: 1px solid #040404;
    color: #ffffff;
    transition: all var(--transition-fast);
  }

  .c-services__circle-link svg {
    stroke: #ffffff;
  }

  .c-services__row:hover .c-services__circle-link {
    background-color: var(--color-brand-accent);
    border-color: var(--color-brand-accent);
    color: #ffffff;
    transform: translateX(3px);
  }
</style>
