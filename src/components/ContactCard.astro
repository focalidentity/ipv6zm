---
import { CONTACT } from '../consts';
---

<div class="c-contact-card">
  <div class="u-badge u-badge--accent">Direct Council Desk</div>
  <h3 class="c-contact-card__title">Official Communication</h3>

  <div class="c-contact-card__rows">
    <!-- Phone row -->
    <a href={CONTACT.phoneTel} class="c-contact-row">
      <span class="c-contact-row__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 7.31 7.31l1.84-1.84a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
      <span class="c-contact-row__body">
        <span class="c-contact-row__label">Phone</span>
        <span class="c-contact-row__val">{CONTACT.phoneDisplay}</span>
      </span>
    </a>

    <!-- Email row -->
    <a href={CONTACT.emailMailto} class="c-contact-row">
      <span class="c-contact-row__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <span class="c-contact-row__body">
        <span class="c-contact-row__label">Email</span>
        <span class="c-contact-row__val">{CONTACT.email}</span>
      </span>
    </a>
  </div>
</div>

<style>
  .c-contact-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-brand-accent);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
  }

  .c-contact-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    color: var(--color-text-heading);
    margin-top: var(--space-2xs);
    margin-bottom: 0;
  }

  .c-contact-card__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .c-contact-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 1rem;
    background-color: var(--color-surface-muted);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
    min-height: 44px;
  }

  .c-contact-row:hover {
    background-color: rgba(253, 83, 32, 0.06);
    border-color: var(--color-brand-accent);
  }

  .c-contact-row__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--color-brand-accent);
    color: #ffffff;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .c-contact-row__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .c-contact-row__label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    line-height: 1.2;
  }

  .c-contact-row__val {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
