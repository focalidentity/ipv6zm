---
import { CONFERENCE } from '../consts';
---

<aside class="c-announcement" aria-label="Conference Announcement">
  <div class="l-container">
    <div class="c-announcement__content">
      <p class="c-announcement__text">
        {CONFERENCE.announcementText}
        <a href={CONFERENCE.announcementCtaHref} class="c-announcement__link">
          {CONFERENCE.announcementCtaText}
        </a>
      </p>
    </div>
  </div>
</aside>

<style>
  .c-announcement {
    background-color: #1F1F1F;
    color: #ffffff;
    padding-block: 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem; /* 15px */
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 64rem) {
    .c-announcement {
      display: none; /* Reference hides top announcement bar on tablet and mobile */
    }
  }

  .c-announcement__content {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .c-announcement__text {
    margin: 0;
    color: #ffffff;
    font-weight: 400;
  }

  .c-announcement__link {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-left: 0.5rem;
    transition: color var(--transition-fast);
  }

  .c-announcement__link:hover {
    color: var(--color-brand-accent);
  }
</style>
