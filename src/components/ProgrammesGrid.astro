---
import { CORE_PROGRAMMES } from '../consts';
---

<section id="programmes" class="c-programmes l-section">
  <div class="l-container">
    <div class="u-section-header">
      <div class="u-badge u-badge--primary">Core Pillars</div>
      <h2>Our latest programmes</h2>
      <p>Three foundational initiatives driving nationwide capacity and strategic alignment.</p>
    </div>

    <div class="l-grid l-grid--3col">
      {
        CORE_PROGRAMMES.map((prog) => (
          <article class="c-program-card l-card l-card--interactive">
            <div class="c-program-card__frame l-frame">
              <img src={prog.image} alt={prog.imageAlt} width="400" height="225" loading="lazy" />
              <span class="c-program-card__tag u-badge u-badge--accent">{prog.category}</span>
            </div>
            <div class="c-program-card__body l-stack l-stack--sm">
              <h3 class="c-program-card__title">
                <a href={prog.href}>{prog.title}</a>
              </h3>
              <p class="c-program-card__desc">{prog.description}</p>
              <div class="c-program-card__footer">
                <a href={prog.href} class="c-program-card__link">
                  Learn more →
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .c-program-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
  }

  .c-program-card__frame {
    margin-block-end: var(--space-md);
  }

  .c-program-card__tag {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 2;
  }

  .c-program-card__title {
    font-size: var(--font-size-h3);
  }

  .c-program-card__title a:hover {
    color: var(--color-brand-secondary);
  }

  .c-program-card__desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
    flex-grow: 1;
  }

  .c-program-card__footer {
    padding-block-start: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .c-program-card__link {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-brand-primary);
  }

  .c-program-card__link:hover {
    color: var(--color-brand-accent);
  }
</style>
